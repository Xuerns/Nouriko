# Copy this file to .env and fill in the values. Never commit .env.
#
# Two runtime modes are supported via APP_ENV:
#   - local      : uses PostgreSQL from docker-compose.yml + local HS256 JWT
#   - production : uses Supabase PostgreSQL (Supavisor) + Supabase Auth (JWKS)

# ---- Mode & Server ----
APP_ENV=local
BACKEND_PORT=8080
FRONTEND_PORT=3000
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1m
AUTH_RATE_LIMIT_MAX=15
AUTH_RATE_LIMIT_WINDOW=1m

# ---- Mode: local (Docker Compose PostgreSQL) ----
POSTGRES_USER=nouriko
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=nouriko
POSTGRES_PORT=5432
# Used when running backend outside Docker in local mode:
DATABASE_URL=postgres://nouriko:change-me-to-a-strong-password@localhost:5432/nouriko?sslmode=disable
# Minimum 32 characters. Required in local mode; optional in production if using legacy Supabase HS256 secret.
AUTH_JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# ---- Mode: production (Supabase) ----
# Set APP_ENV=production, use the Supavisor transaction pooler URL (port 6543, sslmode=require):
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
# SUPABASE_SECRET_KEY=sb_secret_...
# DATABASE_MIGRATE_ON_START=false

# ---- External APIs (Backend only, never exposed to frontend) ----
# Optional in local mode, required in production mode.
# Supported GEMINI_THINKING_LEVEL for gemini-3.5-flash-lite: minimal (default), low, medium, high
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT=60s

# Food nutrition API (provider TBD in PRD)
FOOD_API_BASE_URL=
FOOD_API_KEY=

# ---- Frontend ----
# Public URL of the backend as seen from the browser (inlined at build time).
NEXT_PUBLIC_API_URL=http://localhost:8080
